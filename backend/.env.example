# BirdVision AI backend environment (copy to .env and fill in).
# All secrets stay server-side; none of these are exposed to the browser.

# --- Groq LLM (optional enrichment; CNN works without it) ---
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# --- eBird API 2.0 (optional nearby observations) ---
# Request a key at https://ebird.org/api/keygen
EBIRD_API_KEY=

# --- Model artifacts (defaults to repo root where Colab artifacts live) ---
# ARTIFACTS_DIR=/absolute/path/to/artifacts
# MODEL_FILENAME=birdvision_model.keras

# --- Inference tuning ---
# LOW_CONFIDENCE_THRESHOLD=0.35

# --- Server / CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENVIRONMENT=development
